# Copy to .env and fill in. .env is never committed.

# Postgres connection string used by db.py's connection pool.
DATABASE_URL=postgresql://consiva:CHANGEME@localhost:5432/consiva

# Stage 06 -- contact enrichment
# One key, or a comma-separated pool. Each key carries its own
# 50/min, 200/hour, 600/day allowance, so N keys raise the daily
# contact ceiling to N x 600. The pool is only exhausted when
# every key in it is.
# APOLLO_API_KEYS=key1,key2,key3
APOLLO_API_KEY=
LUSHA_API_KEY=

# Stage 04 -- LinkedIn company enrichment
APIFY_API_TOKEN=

# Stage 03 -- local llama.cpp server for soft-field extraction (LAN only)
LLM_BASE_URL=http://127.0.0.1:8080
LLM_ENABLED=1

# CRM handoff — SQL Server (staging). Password shared separately, never committed.
CRM_DB_HOST=<sql-server-host>
CRM_DB_PORT=15333
CRM_DB_NAME=CookieConsentDB_Staging
CRM_DB_USER=<sql-server-user>
CRM_DB_PASSWORD=
CRM_LEADS_TABLE=crm.CrmLeads
CRM_DB_TABLE=dbo.CRM_Scrapper

# One-page DPDP reports (report_build.py, see docs/REPORTS.md) -- Cloudflare R2
# Endpoint is https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com, region auto.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REPORTS_BUCKET=consiva-reports
# The bucket's custom domain; object key == URL path. No trailing slash.
REPORT_PUBLIC_BASE_URL=https://reports.consiva.tech
# Footer line on every report, e.g. "Sales Team · sales@consiva.ai"
REPORT_SALES_CONTACT=
