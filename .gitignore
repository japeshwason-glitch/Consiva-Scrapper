.env
venv/
__pycache__/
*.pyc
# Ignore the CONTENTS but keep the directories, so a fresh clone has somewhere
# to put the MCA CSV and the exports. Without this, the first scp into
# data/raw/ fails with "No such file or directory".
data/raw/*
data/exports/*
data/backups/
!data/raw/.gitkeep
!data/exports/.gitkeep
logs/*
!logs/.gitkeep
.env.docker
.env.bak
data/partner.pause

# Auto Email Campaign / report job: operational output, never committed (CRM score backups, run CSVs, previews,
# the review file with real company drafts).
data/*_backup_*.json
data/crm_score_backup_*.json
data/report_run_*.csv
data/reports_preview/
data/last_sample_ids.json
data/partner_rescan_*
data/reports.pause
output/
