# Copy to .env and fill in. .env is never committed.

# Postgres connection string used by db.py's connection pool.
DATABASE_URL=postgresql://consiva:CHANGEME@localhost:5432/consiva

# Stage 06 -- contact enrichment
APOLLO_API_KEY=
LUSHA_API_KEY=

# Stage 04 -- LinkedIn company enrichment
APIFY_API_TOKEN=

# Stage 03 -- local llama.cpp server for soft-field extraction (LAN only)
LLM_BASE_URL=http://127.0.0.1:8080
LLM_ENABLED=1

# CRM handoff — SQL Server (staging). Password shared separately, never committed.
CRM_DB_HOST=<sql-server-host>
CRM_DB_PORT=15333
CRM_DB_NAME=CookieConsentDB_Staging
CRM_DB_USER=<sql-server-user>
CRM_DB_PASSWORD=
CRM_DB_TABLE=dbo.CRM_Scrapper
