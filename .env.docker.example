# Container environment. Copy to .env.docker and fill in the secrets.
# Note the hostnames differ from a bare-metal .env: services talk over the
# compose network, and the model lives on the host.

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/consiva

# llama-server runs on the GB10 itself, not in a container.
# Start it with: llama-server -m <model.gguf> --port 8080 --parallel 8 --cont-batching
LLM_BASE_URL=http://host.docker.internal:8080
LLM_ENABLED=1
LLM_TIMEOUT=60

APOLLO_API_KEY=
APOLLO_ALLOW_EMAIL_REVEAL=0
APIFY_API_TOKEN=

# CRM handoff — the sales team's SQL Server
CRM_DB_HOST=<sql-server-host>
CRM_DB_PORT=15333
CRM_DB_NAME=CookieConsentDB_Staging
CRM_DB_USER=<sql-server-user>
CRM_DB_PASSWORD=
CRM_DB_TABLE=dbo.CRM_Scrapper

# Daily guardrails
DAILY_LEAD_TARGET=500
# no scrape cap — the lead target is the only stop
RUN_AT=02:00
