# Container environment. Copy to .env.docker and fill in the secrets.
# Note the hostnames differ from a bare-metal .env: services talk over the
# compose network, and the model lives on the host.

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/consiva

# llama-server runs on the GB10 itself, not in a container.
# Start it with: llama-server -m <model.gguf> --port 8080 --parallel 8 --cont-batching
LLM_BASE_URL=http://host.docker.internal:8080
LLM_ENABLED=1
LLM_TIMEOUT=60

APOLLO_API_KEY=
APOLLO_ALLOW_EMAIL_REVEAL=0
APIFY_API_TOKEN=

# CRM handoff — the sales team's SQL Server
CRM_DB_HOST=<sql-server-host>
CRM_DB_PORT=15333
CRM_DB_NAME=CookieConsentDB_Staging
CRM_DB_USER=<sql-server-user>
CRM_DB_PASSWORD=
CRM_DB_TABLE=dbo.CRM_Scrapper

# Daily guardrails
# Host port for psql/DBeaver access. Change if it collides.
POSTGRES_HOST_PORT=5434

DAILY_LEAD_TARGET=500
# no scrape cap — the lead target is the only stop
RUN_AT=02:00

# Job 3 (PartnerImport rows in dbo.CRM_Scrapper): daily start, 500/day.
# Waits for the MCA run if it is still going; never overlaps it.
PARTNER_RUN_AT=11:05
PARTNER_DAILY_TARGET=500

# One-page DPDP reports (report_build.py, see docs/REPORTS.md) -- Cloudflare R2
# Endpoint is https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com, region auto.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REPORTS_BUCKET=consiva-reports
# The bucket's custom domain; object key == URL path. No trailing slash.
REPORT_PUBLIC_BASE_URL=https://reports-consiva.gignati.com
# Footer line on every report, e.g. "Sales Team · sales@consiva.ai"
REPORT_SALES_CONTACT=

# Auto Email Campaign (campaign/). Real values go in .env.docker, which is git-ignored; never commit a key.
NEVERBOUNCE_API_KEY=
OPENAI_API_KEY=
# mock | live | off. Production companies need live; mock is for the test cohort only.
AE_NB_MODE=mock
AE_NEVERBOUNCE_DAILY_CREDIT_CAP=200
# The one Postgres database allowed to drive a real CRM write.
AE_PRIMARY_DATABASE=consiva
# Production companies are taken in but not processed until this is 1 (or --production is passed).
AE_PRODUCTION_ENABLED=0
# Demo only: write placeholder-template drafts to the CRM as AE_DraftStatus 'expired'.
AE_ALLOW_PLACEHOLDER_AE_WRITE=0
# Title classification and drafting: openai (default) or gignati.
AE_TITLE_PROVIDER=openai
AE_DRAFT_PROVIDER=openai
